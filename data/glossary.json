[
 {
  "term": "斜裁",
  "en": "Bias cut",
  "aliases": [
   "bias",
   "bias cut",
   "斜紋裁剪"
  ],
  "text": "把布料沿著與布紋呈 45 度的方向裁剪。斜向的布有彈性，能順著身體自然垂墜和貼合。",
  "example": "1930 年代的絲質晚禮服常用斜裁，裙擺會隨走路流動。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Bias cut",
    "url": "https://en.wikipedia.org/w/index.php?search=Bias%20cut"
   }
  ]
 },
 {
  "term": "立裁",
  "en": "Draping",
  "aliases": [
   "立體裁剪",
   "draping",
   "立體剪裁"
  ],
  "text": "直接把布料披在人台上，一邊別針、一邊修剪，找出衣服的形狀，再轉成紙型。適合處理垂墜和不規則的設計。",
  "example": "設計師在人台上把一塊布扭轉、固定，做出領口的皺褶。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Draping",
    "url": "https://en.wikipedia.org/w/index.php?search=Draping"
   }
  ]
 },
 {
  "term": "打版",
  "en": "Pattern making",
  "aliases": [
   "版型",
   "紙型",
   "pattern",
   "pattern making",
   "製版"
  ],
  "text": "把設計圖轉換成可以裁布的紙型。打版決定衣服的尺寸、比例和合身程度，是從設計到成品的關鍵步驟。",
  "example": "同一件襯衫，打版不同就可能變成合身款或寬鬆款。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Pattern making",
    "url": "https://en.wikipedia.org/w/index.php?search=Pattern%20making"
   }
  ]
 },
 {
  "term": "高級訂製",
  "en": "Haute couture",
  "aliases": [
   "高訂",
   "haute couture",
   "couture",
   "高級訂製服"
  ],
  "text": "在巴黎受法規保護的稱號，指依客人身形量身、以大量手工製作的頂級服裝。時裝屋必須符合工坊規模與發表等條件。",
  "example": "一件高訂禮服可能需要工坊花上數百小時手工刺繡。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Haute couture",
    "url": "https://en.wikipedia.org/w/index.php?search=Haute%20couture"
   }
  ]
 },
 {
  "term": "成衣",
  "en": "Ready-to-wear",
  "aliases": [
   "prêt-à-porter",
   "ready-to-wear",
   "RTW"
  ],
  "text": "依標準尺寸大量生產、可以直接購買穿著的衣服。1960 年代起設計師開始推出成衣線，讓設計走進一般人的生活。",
  "example": "在百貨公司依 S、M、L 尺寸挑選的外套就是成衣。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Ready-to-wear",
    "url": "https://en.wikipedia.org/w/index.php?search=Ready-to-wear"
   }
  ]
 },
 {
  "term": "新風貌",
  "en": "New Look",
  "aliases": [
   "new look",
   "迪奧新風貌"
  ],
  "text": "迪奧在 1947 年發表的女裝輪廓：圓潤的肩、收緊的細腰和寬大的長裙。它象徵二戰後重新追求優雅與豐盛的心情。",
  "example": "收腰外套搭配及小腿的蓬裙，是新風貌的典型組合。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 New Look",
    "url": "https://en.wikipedia.org/w/index.php?search=New%20Look"
   }
  ]
 },
 {
  "term": "A 字線",
  "en": "A-line",
  "aliases": [
   "A字裙",
   "A-line",
   "a line",
   "A字線"
  ],
  "text": "上窄下寬、外形像英文字母 A 的輪廓。迪奧在 1955 年以 A 線命名系列，之後成為裙子與洋裝的基本款式。",
  "example": "從腰部自然往外展開、不貼身的半身裙。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 A-line",
    "url": "https://en.wikipedia.org/w/index.php?search=A-line"
   }
  ]
 },
 {
  "term": "墊肩",
  "en": "Shoulder pad",
  "aliases": [
   "shoulder pad",
   "肩墊"
  ],
  "text": "放在肩部內側的填充物，用來撐出肩膀的寬度和線條。1940 與 1980 年代特別流行，常和「權力套裝」聯想在一起。",
  "example": "1980 年代的西裝外套常有又寬又方的肩線。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Shoulder pad",
    "url": "https://en.wikipedia.org/w/index.php?search=Shoulder%20pad"
   }
  ]
 },
 {
  "term": "極簡主義",
  "en": "Minimalism",
  "aliases": [
   "minimalism",
   "極簡",
   "minimal"
  ],
  "text": "以簡單的線條、少量裝飾和克制的顏色為主的設計風格，重點放在布料品質與比例。1990 年代是時尚極簡主義的高峰。",
  "example": "一件沒有任何印花和配件的灰色長大衣。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Minimalism",
    "url": "https://en.wikipedia.org/w/index.php?search=Minimalism"
   }
  ]
 },
 {
  "term": "機能服裝",
  "en": "Technical wear",
  "aliases": [
   "techwear",
   "機能",
   "功能性服裝",
   "technical"
  ],
  "text": "重視防水、透氣、保暖、耐磨等功能的服裝，常用科技布料和實用的口袋、拉鍊設計。近年也成為日常時尚的一部分。",
  "example": "可以收納手機和水壺、又能擋雨的城市外套。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Technical wear",
    "url": "https://en.wikipedia.org/w/index.php?search=Technical%20wear"
   }
  ]
 },
 {
  "term": "成衣染色",
  "en": "Garment dyeing",
  "aliases": [
   "garment dye",
   "garment dyeing",
   "成品染色"
  ],
  "text": "先把衣服縫好，再整件放進染缸染色。縫線和布料吸色程度不同，會產生柔和、有層次的顏色。",
  "example": "Stone Island 等品牌常用這種方法讓衣服有自然的色差。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Garment dyeing",
    "url": "https://en.wikipedia.org/w/index.php?search=Garment%20dyeing"
   }
  ]
 },
 {
  "term": "梭織",
  "en": "Woven fabric",
  "aliases": [
   "woven",
   "平織布",
   "梭織布"
  ],
  "text": "由經紗（直向）和緯紗（橫向）上下交錯織成的布，通常比較挺、不太有彈性。襯衫、西裝和牛仔布都屬於梭織。",
  "example": "把襯衫布對著光看，可以看到縱橫交錯的格子紋路。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Woven fabric",
    "url": "https://en.wikipedia.org/w/index.php?search=Woven%20fabric"
   }
  ]
 },
 {
  "term": "針織",
  "en": "Knit fabric",
  "aliases": [
   "knit",
   "knitting",
   "針織布",
   "jersey"
  ],
  "text": "由紗線繞成一個個線圈互相串連而成的布，有彈性、柔軟、好活動。T 恤、毛衣和運動服多半是針織。",
  "example": "把 T 恤布往旁邊拉，它會伸長再回彈。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Knit fabric",
    "url": "https://en.wikipedia.org/w/index.php?search=Knit%20fabric"
   }
  ]
 },
 {
  "term": "平紋",
  "en": "Plain weave",
  "aliases": [
   "plain weave",
   "平織"
  ],
  "text": "最基本的梭織方式：經紗和緯紗一上一下交錯。結構穩定、表面平整，常見於府綢、帆布等布料。",
  "example": "襯衫常用的府綢布就是平紋織法。",
  "method": "本站編輯詞條",
  "sources": [
   {
    "title": "維基百科：搜尋 Plain weave",
    "url": "https://en.wikipedia.org/w/index.php?search=Plain%20weave"
   }
  ]
 },
 {
